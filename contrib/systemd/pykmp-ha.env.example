# MQTT connection (required)
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=homeassistant
MQTT_PASSWORD=secret
MQTT_BASE_TOPIC=pykmp
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_DISCOVERY=true
MQTT_RETAIN=true

# Meter connection
PYKMP_SERIAL_DEVICE=/dev/ttyUSB0
PYKMP_DESTINATION_ADDRESS=63
PYKMP_REGISTERS="60 68 80 74 86 87 266"

# Polling interval in seconds (300 = 5 minutes)
PYKMP_INTERVAL_SECONDS=300
